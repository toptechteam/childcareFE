# Environment
NODE_ENV=development

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT=10000

# Public URLs (frontend)
# Example production values:
# VITE_PUBLIC_SITE_ORIGIN=https://childcarestories.com.au
# VITE_APP_SITE_ORIGIN=https://app.childcarestories.com.au
VITE_PUBLIC_SITE_ORIGIN=http://localhost:5173
VITE_APP_SITE_ORIGIN=http://localhost:5173

# Contact emails (optional)
VITE_SUPPORT_EMAIL=support@childcarestories.com.au
VITE_HELLO_EMAIL=hello@childcarestories.com.au

# Authentication
VITE_AUTH_TOKEN_KEY=auth_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_TOKEN_EXPIRY_KEY=token_expiry

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_MAINTENANCE_MODE=false

# Third-party Services
# Stripe.js (required for /subscription card form). Must be set at build time for production.
# Use pk_live_... on production; pk_test_... locally. Must match the backend Stripe account/mode.
VITE_STRIPE_PUBLIC_KEY=pk_test_your_publishable_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_GOOGLE_ANALYTICS_ID=your_ga_id_here

# App Configuration
VITE_APP_NAME=ChildcareFE
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="Childcare Frontend Application"

# Development Settings
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug
